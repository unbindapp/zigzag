{
  "name": "zigzag",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.19.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "eslint . && vite build",
    "preview": "vite preview",
    "lint": "eslint . && node scripts/check-ui-consistency.mjs",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.node-test.ts'",
    "generate-sdk": "go -C ../api run ./cmd/openapi > /tmp/zigzag-openapi.yaml && node ./scripts/generate-sdk/main.ts -i /tmp/zigzag-openapi.yaml"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-form": "^1.33.0",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-router": "^1.170.16",
    "@tanstack/react-virtual": "^3.14.3",
    "@tanstack/zod-adapter": "^1.167.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-task-item": "^3.32.0",
    "@tiptap/extension-task-list": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^5.0.0",
    "fuzzysort": "^4.0.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.47.0",
    "motion": "^12.4.7",
    "next-themes": "^0.4.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.2",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/router-plugin": "^1.168.18",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.9",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.0.16",
    "yaml": "^2.7.0"
  }
